# Unity generated directories
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# IDE files
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Build/debug output from the native probe
Tools/**/bin/
Tools/**/obj/

# LLMUnity copies multi-gigabyte native runtime files here while running/building.
# They are regenerated by the embedded package and exceed GitHub's file limit.
Assets/StreamingAssets/LlamaLib-v*/
Assets/StreamingAssets/LlamaLib-v*.meta

# Local model files must be downloaded separately and are never committed.
*.gguf
*.ggml
*.bin

# Crash dumps and diagnostic artifacts
*.dmp
*.stacktrace
sysinfo.txt
